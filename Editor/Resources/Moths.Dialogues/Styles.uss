:root
{
	--dark: #282828;
	--mid: #383838;
	--light: #515151;
	--lighter: #D2D2D2;
	--pressed: #46607C;

	--text-inactive-color: var(--light);
	--text-active-color: var(--lighter);

	--border-color: var(--dark);
	--border-inactive-color: var(--mid);
	--border-active-color: var(--lighter);

	--button-inactive-color: var(--dark);
	--button-active-color: var(--light);
	--button-hover-color: #676767;
	--button-press-color: var(--pressed);

	--window-inactive-color: var(--dark);
	--window-active-color: var(--mid);

	--property-bg-color: var(--dark);

	--border-radius: 5px;
}

/*BUTTONS*/

Button
{
	color: var(--text-active-color);
	border-color: var(--border-color);
	background-color: var(--button-active-color);
}

Button:hover
{
	background-color: var(--button-hover-color);
}

Button:active
{
	background-color: var(--button-press-color);
}


Sidebar {
	height: auto;
	width: 200px;
	margin: 5px;
	border-width: 1px;
	border-color: var(--light);
	border-radius: var(--border-radius);
	background-color: var(--window-active-color);
}

.inspector {
	width: 400px;
	padding: 5px;
}

.right-align {
    position: absolute;
    right: 0;
	height: auto;
}

.sidebar-title {
	margin: 5px;
	font-size: 18px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
}

.sidebar-element-btn{
	width: 45px;
	height: 45px;
}

.sidebar-element-btn .unity-image{
	position: absolute;
	right: 0px;
	left: 0px;
	bottom: 0px;
	top: 0px;
}

Sidebar Category {
	width: 100%;
	padding: 5px;
	height: auto;

    border-top-width: 1px;
    border-top-color: gray;
}

Sidebar Category .content {
	flex-direction: row;
	flex-wrap: wrap;
	margin: 5px;
	justify-content: center;
}


Sidebar Category Label {
	font-size: 14px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
}

Sidebar .new-quest-btn {
	height: 28px;
	width: 50%;
	align-self: center;
}

HistoryStack {
	width: 100%;
	height: 20px;
	margin: 5px;
	margin-left: 205px;
	flex-direction: row;
}

HistoryStack Button 
{
	background-color: transparent;
	border-width: 0px;
	border-color: transparent;
}
